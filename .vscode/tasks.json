{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll: Serve (livereload)",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload --incremental --drafts --open-url",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^\\s*(ERROR|WARN|Error):\\s+(.*)$",
              "severity": 1,
              "message": 2
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\s*Generating\\.\\.\\..*$",
            "endsPattern": "^\\s*Server running.*$|^\\s*done in.*$"
          }
        }
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Jekyll: Build",
      "type": "shell",
      "command": "bundle exec jekyll build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Jekyll: Stop Server",
      "type": "shell",
      "command": "taskkill //F //IM ruby.exe //T 2>/dev/null || true",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
